{
  "name": "smartify-ai",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @smartify/database exec prisma migrate dev",
    "db:migrate:safe": "pnpm --filter @smartify/database exec tsx prisma/migrate-safe.ts",
    "db:backup": "pnpm --filter @smartify/database exec tsx prisma/backup-guard.ts",
    "db:deploy": "pnpm --filter @smartify/database exec prisma migrate deploy",
    "db:generate": "pnpm --filter @smartify/database exec prisma generate",
    "db:seed": "pnpm --filter @smartify/database exec prisma db seed",
    "db:verify": "pnpm --filter @smartify/database exec tsx prisma/verify-seed.ts",
    "db:budget-cleanup:preview": "pnpm --filter @smartify/database exec tsx prisma/cleanup-budget-reservations.ts --dry-run",
    "db:budget-cleanup": "pnpm --filter @smartify/database exec tsx prisma/cleanup-budget-reservations.ts",
    "infra:up": "docker compose up -d --wait postgres redis",
    "infra:down": "docker compose down",
    "staging:verify": "pnpm db:deploy && pnpm db:seed && pnpm db:seed && pnpm db:verify"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.7.0",
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express@10.4.22>multer": "2.2.0"
    }
  }
}
