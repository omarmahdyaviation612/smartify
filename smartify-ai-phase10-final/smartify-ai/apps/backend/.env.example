NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/smartify_ai
REDIS_URL=redis://localhost:6379

CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

OPENAI_API_KEY=
# Model + pricing are configured via the AIProviderConfig database table
# (seeded with gpt-4o-mini by default), not env vars — see
# 06-phase6-decisions.md. This key is the only piece that must be set
# here for the AI Tutor to actually work.

RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Post-lesson-check parent-notification emails (EmailService/Resend).
# Leaving RESEND_API_KEY unset simply means those emails are skipped (logged,
# never a crash) — the lesson/quiz flow itself is fully unaffected either
# way. RESEND_FROM_EMAIL must be on a domain verified in your Resend
# account; leave unset in development to use Resend's own shared test
# sender (onboarding@resend.dev), which only delivers to the email address
# on your Resend account.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Payments stay OFF (PaymentProviderConfig.isActive=false for all
# providers) until real credentials are set here AND the corresponding
# PaymentProviderConfig row is flipped active — see 08-phase8-decisions.md.

FRONTEND_URL=http://localhost:3000

# Manual InstaPay payment method: real money-routing details, so they live
# here (deploy-time config) rather than an admin-editable DB field. Leaving
# these unset simply means InstaPay initiate requests fail with a clear
# "not configured" error — the app still boots and every other feature
# works. PaymentProviderConfig.isActive still separately controls whether
# InstaPay is *offered* to students at all.
INSTAPAY_RECIPIENT_NAME=
INSTAPAY_RECIPIENT_HANDLE=
INSTAPAY_INSTRUCTIONS_EN=
INSTAPAY_INSTRUCTIONS_AR=

# Local-dev/admin fallback for real textbook PDFs (a sibling of this repo,
# never checked into git). Used automatically whenever CURRICULUM_STORAGE_
# PROVIDER below isn't "s3" — both the offline grounding-extraction script
# and the live lazy-grounding path can read from here.
CURRICULUM_SOURCES_DIR=

# Private cloud object storage for real textbook PDFs (production). Leave
# CURRICULUM_STORAGE_PROVIDER unset (or "local") to use CURRICULUM_SOURCES_DIR
# above instead. One S3-compatible client covers AWS S3, Cloudflare R2, and
# MinIO — set CURRICULUM_S3_ENDPOINT/FORCE_PATH_STYLE only for the latter two.
# The bucket must be private.
CURRICULUM_STORAGE_PROVIDER=
CURRICULUM_S3_BUCKET=
CURRICULUM_S3_REGION=
CURRICULUM_S3_ENDPOINT=
CURRICULUM_S3_ACCESS_KEY_ID=
CURRICULUM_S3_SECRET_ACCESS_KEY=
CURRICULUM_S3_FORCE_PATH_STYLE=
