NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/smartify_ai
REDIS_URL=redis://localhost:6379

CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

OPENAI_API_KEY=
# Model + pricing are configured via the AIProviderConfig database table
# (seeded with gpt-4o-mini by default), not env vars — see
# 06-phase6-decisions.md. This key is the only piece that must be set
# here for the AI Tutor to actually work.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Payments stay OFF (PaymentProviderConfig.isActive=false for all
# providers) until real credentials are set here AND the corresponding
# PaymentProviderConfig row is flipped active — see 08-phase8-decisions.md.

FRONTEND_URL=http://localhost:3000
