generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ IDENTITY & ROLES ============

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  SUPPORT
  TEACHER
  PARENT
  STUDENT
}

model User {
  id            String    @id @default(cuid())
  clerkUserId   String    @unique // external identity from Clerk; sync boundary
  email         String    @unique
  role          UserRole  @default(STUDENT)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  teacherProfile TeacherProfile?
  auditLogs      AuditLog[]
  linkInvitations ParentLinkInvitation[]

  @@index([role])
  @@index([clerkUserId])
}

model StudentProfile {
  id               String     @id @default(cuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id])
  fullName         String
  age              Int
  country          String
  preferredLang    String // "ar" | "en"
  curriculumId     String
  curriculum       Curriculum @relation(fields: [curriculumId], references: [id])
  gradeId          String
  grade            Grade      @relation(fields: [gradeId], references: [id])
  weeklyStudyHours Int?
  goals            String?

  // Student school info V1 (2026-09-25) — collected as an extension of the
  // existing onboarding profile step, not a new signup flow. All four are
  // nullable so every existing production StudentProfile row (created
  // before this feature) stays valid without a backfill. Deliberately NOT
  // GPS/address — governorate + area + school only, per product privacy
  // rule. schoolId and schoolNameManual are mutually exclusive: the
  // student either picked a real School row (schoolId set, schoolNameManual
  // null) or typed one manually via "My school isn't listed"
  // (schoolNameManual set, schoolId null) — enforced by
  // studentOnboardingSchema, never trusted from the client alone (see
  // OnboardingService.saveProfile, which re-validates schoolId server-side).
  governorate      String?
  area             String?
  schoolId         String?
  school           School?    @relation(fields: [schoolId], references: [id])
  schoolNameManual String?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  subjects         StudentSubject[]
  progress         StudentProgress[]
  learningPlans    LearningPlan[]
  quizResults      QuizResult[]
  questionAttempts QuestionAttempt[]
  achievements     StudentAchievement[]
  aiConversations  AIConversation[]
  lessonSessions   LessonSession[]
  aiCredits        AICredits?
  subscription     Subscription?
  freeTutorTrial   FreeTutorTrial?
  parentLinks      ParentStudentRelation[]
  linkInvitations  ParentLinkInvitation[]
  assessments      Assessment[]
  questionPackPurchases TutorQuestionPackPurchase[]
  extraQuestionCredits TutorExtraQuestionCredit[]
  instapaySubmissions InstapayPaymentSubmission[]

  // Free Trial + Referral V1 (2026-09-20)
  lessonTrial       LessonTrial?
  lessonTrialConsumptions LessonTrialConsumption[]
  referralCode      ReferralCode?
  referralsMade     Referral[] @relation("ReferralsMade")
  referredBy        Referral?  @relation("ReferredStudent")
}

model ParentProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  fullName String

  children ParentStudentRelation[]
}

model TeacherProfile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  fullName String
  // Reserved for future class/assignment management (Phase 2 defines the role & table only)
}

model ParentStudentRelation {
  id                   String         @id @default(cuid())
  parentId             String
  parent               ParentProfile  @relation(fields: [parentId], references: [id])
  studentId            String
  student              StudentProfile @relation(fields: [studentId], references: [id])
  canViewConversations Boolean        @default(false)
  createdAt            DateTime       @default(now())

  @@unique([parentId, studentId])
}

model ParentLinkInvitation {
  id            String         @id @default(cuid())
  code          String         @unique
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  createdByUserId String
  createdByUser  User           @relation(fields: [createdByUserId], references: [id])
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime       @default(now())

  @@index([studentId, expiresAt])
}

// ============ SCHOOL DIRECTORY (Student school info V1, 2026-09-25) ============
//
// Deliberately provider-agnostic: `source`/`externalRef` describe WHERE a
// row came from without hard-coding to any one provider (e.g. Google
// Places). Expected future sources: "MOE" (an official Egyptian education
// dataset), "ADMIN" (admin-managed list), "IMPORT" (a bulk import job),
// "EXTERNAL" (a future external API) — none of these are integrated yet;
// "SEED" is used only for tiny dev/test fixtures. StudentProfile.schoolId
// references this table when a student picks a real, known school;
// StudentProfile.schoolNameManual is the fallback for a school not yet in
// this table ("My school isn't listed"), so onboarding never blocks on
// this table being incomplete.
model School {
  id          String   @id @default(cuid())
  nameEn      String
  nameAr      String?
  governorate String
  area        String?
  source      String // "SEED" | "MOE" | "ADMIN" | "IMPORT" | "EXTERNAL"
  externalRef String? // opaque id/code from whatever `source` populated it — never assumed to be a Google Place ID or any specific provider's format
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  studentProfiles StudentProfile[]

  // Powers GET /schools?governorate=&area=&q= — governorate is always
  // supplied by the frontend (chosen before school search becomes
  // available), so it leads the composite index; isActive is included so
  // the common "active schools in this governorate" filter is fully
  // covered without a separate scan.
  @@index([governorate, isActive])
  @@index([governorate, area])
}

// ============ CURRICULUM HIERARCHY ============

model Curriculum {
  id       String  @id @default(cuid())
  nameEn   String
  nameAr   String
  code     String  @unique // "LOCAL" | "EG_NATIONAL" | "BRITISH_INTL" | "AMERICAN_INTL"
  country  String?
  isActive Boolean @default(true)

  grades          Grade[]
  studentProfiles StudentProfile[]
  pricingPlans    PricingPlan[]
  tutorAnswerCache TutorAnswerCache[]
}

model Grade {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
  nameEn       String
  nameAr       String
  level        Int // sort order / numeric grade
  isActive     Boolean    @default(true)

  subjects        Subject[]
  studentProfiles StudentProfile[]
  tutorAnswerCache TutorAnswerCache[]

  @@index([curriculumId])
}

model Subject {
  id       String  @id @default(cuid())
  gradeId  String
  grade    Grade   @relation(fields: [gradeId], references: [id])
  nameEn   String
  nameAr   String
  icon     String?
  isActive Boolean @default(true)

  // Real-textbook grounding (2026-09-19): path relative to the
  // curriculum-sources/ directory, e.g. "British IG/year 5/science y5 .pdf".
  // Nullable — a Subject with no mapped PDF simply never gets grounded
  // (Unit.groundingNotesJson stays null), and generation falls back to the
  // existing title-only behavior. See Unit.groundingNotesJson.
  sourceFile String?

  // Subject-based pricing (2026-09-20): replaces the old PricingPlan
  // "curriculum bundle, N subjects included, extras cost more" model —
  // every Subject now has its OWN independent monthly price, admin-set,
  // never hardcoded. Null means "not yet priced by an admin" — such a
  // Subject cannot be selected for checkout (BillingService rejects it
  // explicitly rather than treating null as free). PricingPlan itself is
  // left in the schema untouched, purely for historical Subscription rows
  // created under the old model.
  priceEGP Decimal?

  units           Unit[]
  studentSubjects StudentSubject[]
  assessments     Assessment[]
  questionPackPurchases TutorQuestionPackPurchase[]
  extraQuestionCredits TutorExtraQuestionCredit[]
  tutorAnswerCache TutorAnswerCache[]
  freeTutorTrials FreeTutorTrial[]
  materials       LearningMaterial[]
  lessonTrialConsumptions LessonTrialConsumption[]
  referralRewards Referral[]

  @@index([gradeId])
}

model StudentSubject {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id])
  createdAt DateTime       @default(now())

  // Referral reward V1 (2026-09-20): null = permanent access (every
  // existing row, and every row granted by a real Subject purchase —
  // BillingService.grantSelectedSubjects never sets this). A non-null
  // value is a TIME-LIMITED grant (currently only ReferralService's "30
  // free days for one Subject" reward) — entitlement checks that read
  // this table (Practice/Quiz's assertSubjectOwned) must treat a row as
  // owned only while expiresAt is null OR still in the future. Nothing
  // ever deletes an expired row; access simply stops being granted once
  // the check re-evaluates against the current time.
  expiresAt DateTime?

  @@unique([studentId, subjectId])
}

model FreeTutorTrial {
  id           String         @id @default(cuid())
  studentId    String         @unique
  student      StudentProfile @relation(fields: [studentId], references: [id])
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id])
  questionsUsed Int           @default(0)
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  @@index([subjectId])
}

// Pilot addition (real-curriculum phase): which school term a Unit belongs
// to. Nullable/optional by design — existing seeded units have no term and
// remain fully valid; only newly-authored real-curriculum units set this.
enum Term {
  TERM_1
  TERM_2
}

model Unit {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  nameEn    String
  nameAr    String
  order     Int
  term      Term?

  // Real-textbook grounding (2026-09-19): the page range within
  // Subject.sourceFile that this Unit's content was transcribed from —
  // backfilled from curriculum-pilot/toc-manifests/*.json's sourcePage
  // (start) and the next unit's sourcePage - 1 / the subject's totalPages
  // (end). Nullable — a Unit with no mapped page range can't be grounded
  // automatically; extraction then requires an explicit --pages override.
  sourcePageStart Int?
  sourcePageEnd   Int?

  // English Extra Book / Story support V1 (2026-09-20): an exceptional
  // per-Unit override of which R2 object this Unit's real source pages
  // come from, for Units that belong to a Subject but were transcribed
  // from a DIFFERENT PDF than that Subject's main textbook (e.g. an
  // English "Story" book, distinct from the English course book). Null
  // for every ordinary Unit — the effective source is then
  // Subject.sourceFile exactly as before. Deliberately Unit-level, not a
  // new Material/Textbook model — see UnitGroundingService's effective-
  // source resolution (subject.sourceFile is the base case,
  // sourceFileOverride wins when set).
  sourceFileOverride String?

  // The cached result of one offline "grounding extraction" run (see
  // UnitGroundingService) — real, original, non-verbatim structured notes
  // (concepts/facts/objectives/vocabulary — never copied textbook prose)
  // derived from Subject.sourceFile's real pages. Generated ONCE per Unit,
  // read forever after by every Topic's lazy generation under it — same
  // "generate once, cache forever" pattern as Topic.teachingStepsJson.
  // Null means "not yet grounded" (or no source PDF mapped at all) —
  // generation gracefully falls back to today's title-only behavior, never
  // blocks a student.
  groundingNotesJson Json?
  groundingGeneratedAt DateTime?
  // Bumped only when the grounding EXTRACTION schema/methodology changes in
  // a way that would make old groundingNotesJson stale — never touched by
  // downstream lesson/question generation itself. Used (with
  // generationPromptVersion on Topic) to identify already-generated content
  // as eligible for a later, deliberate, admin-triggered regeneration —
  // never an automatic one during a student's request.
  groundingVersion Int?
  groundingModel String?
  groundingPromptVersion String?
  // sha256 of (PDF bytes + page range + extraction-prompt version) — lets
  // us detect that a source PDF or selected page range changed since this
  // Unit was last grounded, without storing any textbook content itself.
  groundingSourceFingerprint String?

  // Production lazy-grounding single-flight lock (2026-09-19): when a real
  // student's request discovers groundingNotesJson is null, it must not
  // race every other simultaneous request for a Topic under this same Unit
  // into starting its own PDF fetch + vision extraction. Claimed via an
  // atomic UPDATE ... WHERE (see UnitGroundingService.ensureUnitGrounded),
  // never a long-held DB transaction across the OpenAI call. Stale locks
  // (a crashed worker) are reclaimed after a timeout — see the same
  // method — so this can never permanently block a Unit.
  groundingLockedAt DateTime?
  groundingLockedBy String?

  topics Topic[]
  lessonDrafts LessonDraft[]

  @@index([subjectId])
}

model Topic {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
  nameEn String
  nameAr String
  order  Int

  // Pilot addition: compact, ordered pedagogy for the Interactive Lesson
  // engine — WHAT to teach and in what order (step type, objective,
  // concept key, whether a visual/check applies). Never holds prewritten
  // teacher speech; the AI generates the actual wording per student at
  // runtime from this structure. Nullable — topics without an interactive
  // lesson plan behave exactly as before (Practice/Quiz/Tutor unaffected).
  teachingStepsJson Json?

  // Real-textbook grounding (2026-09-19): records HOW this Topic's cached
  // content was generated — "LEGACY_TITLE_ONLY" (today's behavior, no real
  // source material) or "TEXTBOOK_GROUNDED" (generated using the parent
  // Unit's groundingNotesJson at the time). Nullable — null means never
  // generated at all (teachingStepsJson is also still null in that case).
  // Never rewritten automatically once set; only a deliberate, manual
  // regeneration (apps/backend/src/scripts/regenerate-topic-content.ts)
  // changes it. Used to identify which already-live Topics could benefit
  // from a later, selective, admin-triggered regrounding — never to
  // trigger one on its own.
  generationSource String?
  groundingVersionUsed Int?
  generationPromptVersion String?
  contentGeneratedAt DateTime?

  // Production lazy-generation single-flight lock (2026-09-19) — same
  // rationale/pattern as Unit.groundingLockedAt, one level down: two
  // students opening the same never-generated Topic at once must not both
  // run a full AI generation + publish. See
  // LessonDraftGeneratorService.ensureTopicHasLesson.
  generationLockedAt DateTime?
  generationLockedBy String?

  lessons   Lesson[]
  questions Question[]
  questionDrafts QuestionDraft[]
  tutorAnswerCache TutorAnswerCache[]
  materials LearningMaterial[]
  lessonSessions LessonSession[]
  visualAssets   LessonVisualAsset[]
  publishedFromDraft LessonDraft?
  quizResults    QuizResult[]
  lessonTrialConsumptions LessonTrialConsumption[]

  @@index([unitId])
}

// Phase 4: the actual generated bytes for ONE teachingStepsJson step's
// `visual` (curriculum content, generated once and reused by every
// student — never per-student). Mirrors InstapayPaymentSubmission's
// receiptImage pattern (Bytes in Postgres, not a filesystem/CDN path) so
// this needs no new storage infrastructure. teachingStepsJson keeps
// carrying {type, status, url} for that step's visual — `url` points back
// to GET /lesson/visuals/:id, which streams this row's bytes.
model LessonVisualAsset {
  id        String   @id @default(cuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id])
  stepId    String // the TeachingStep.id (within topic.teachingStepsJson) this visual belongs to
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([topicId, stepId])
}

// Phase 5: an AI-generated lesson draft awaiting human review — NEVER a
// real Topic row, deliberately. Nothing in the app queries LessonDraft (the
// student dashboard/lesson engine only ever read real Topic rows), so a
// draft existing here can never leak to students regardless of its
// `status`. Becoming real, student-facing curriculum content is a
// SEPARATE, explicit publish step for a later phase (create a real Topic
// from an "approved" draft) — this table only holds the pre-publish state.
model LessonDraft {
  id                     String    @id @default(cuid())
  targetUnitId           String? // the existing Unit this would publish under, if approved — informational only, no cascading behavior
  targetUnit             Unit?     @relation(fields: [targetUnitId], references: [id])
  topicNameEn            String
  topicNameAr            String
  learningObjectivesJson Json
  teachingStepsJson      Json
  status                 String    @default("pending_review") // "pending_review" | "approved" | "rejected"
  aiProvider             String
  aiModel                String
  createdAt              DateTime  @default(now())
  reviewedAt             DateTime?
  reviewedByUserId       String?

  // Phase 6: the reliable draft <-> published-Topic linkage Part E
  // requires — never rely on matching names. `publishedTopicId` is unique
  // so at most one draft can ever claim to have published a given Topic,
  // and re-publishing the same already-published draft is a safe no-op
  // (see LessonPublishService) rather than creating a duplicate Topic.
  publishedTopicId String?   @unique
  publishedTopic   Topic?    @relation(fields: [publishedTopicId], references: [id])
  publishedAt      DateTime?

  @@index([status])
}

model LearningMaterial {
  id           String   @id @default(cuid())
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topicId      String?
  topic        Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  contentText  String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([topicId])
  @@index([subjectId])
}

model Lesson {
  id            String  @id @default(cuid())
  topicId       String
  topic         Topic   @relation(fields: [topicId], references: [id])
  nameEn        String
  nameAr        String
  order         Int
  contentEn     String? @db.Text
  contentAr     String? @db.Text
  isAiGenerated Boolean @default(false) // distinguishes AI-generated vs. verified curriculum content
  isPlaceholder Boolean @default(false) // marks seed/demo content, never shown as reviewed curriculum
  // Launch-speed lazy-generation path (2026-09-18): set true for a lesson
  // published via LessonPublishService.autoPublishIntoTopic(), where the AI
  // supplied its own Arabic objective translations directly and no human
  // called reviewObjectives()/approve(). Never set for the original
  // human-reviewed pipeline. Purely a later-audit marker — nothing in the
  // app currently gates on it.
  needsReview   Boolean @default(false)

  objectives LearningObjective[]
  progress   StudentProgress[]

  @@index([topicId])
}

model LearningObjective {
  id            String @id @default(cuid())
  lessonId      String
  lesson        Lesson @relation(fields: [lessonId], references: [id])
  descriptionEn String
  descriptionAr String
}

// ============ PROGRESS & LEARNING PLANS ============

model StudentProgress {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id])
  lessonId     String
  lesson       Lesson         @relation(fields: [lessonId], references: [id])
  status       String // "not_started" | "in_progress" | "completed"
  masteryScore Float? // 0-100
  timeSpentSec Int            @default(0)
  updatedAt    DateTime       @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId])
}

model LearningPlan {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  title     String
  planJson  Json // structured plan: daily/weekly tasks, AI-generated
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@index([studentId])
}

// ============ ASSESSMENTS, QUESTIONS, QUIZZES ============

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  FILL_BLANK
  MATCHING
  STEP_PROBLEM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id                String       @id @default(cuid())
  topicId           String
  topic             Topic        @relation(fields: [topicId], references: [id])
  type              QuestionType
  difficulty        Difficulty
  promptEn          String       @db.Text
  promptAr          String?      @db.Text
  optionsJson       Json? // choices for MCQ/matching
  correctAnswerJson Json
  explanationEn     String?      @db.Text
  explanationAr     String?      @db.Text
  isAiGenerated     Boolean      @default(false)
  isPlaceholder     Boolean      @default(false)
  // Launch-speed lazy-generation path (2026-09-19): set true for a
  // question published via QuestionPublishService.autoPublish(), where
  // the AI supplied its own Arabic prompt/explanation directly and no
  // human called reviewDraft()/approve(). Never set for the original
  // human-reviewed pipeline. Mirrors Lesson.needsReview exactly — purely
  // a later-audit marker, nothing in the app currently gates on it.
  needsReview       Boolean      @default(false)
  createdAt         DateTime     @default(now())

  attempts QuestionAttempt[]
  publishedFromDraft QuestionDraft?

  @@index([topicId, difficulty])
}

// Phase 10E: a Question Bank draft awaiting human review — mirrors
// LessonDraft's proven pending_review -> approved -> published pipeline
// exactly (see LessonDraft's own doc comment). NEVER a real Question row —
// nothing in Diagnostic/Practice/Quiz/Mock queries QuestionDraft, so a
// draft sitting here in any status can never reach a student regardless of
// content. Becoming a real, gradeable Question is a separate, explicit
// publish step (QuestionPublishService.publish()), gated on
// QuestionPublishService.approve() having already passed the deterministic
// validator (question-draft-validator.ts) AND required human-reviewed
// bilingual content being present — the AI's own proposed Arabic (if any)
// is never trusted or auto-applied, exactly like LessonDraft.objectiveAr.
model QuestionDraft {
  id                String       @id @default(cuid())
  topicId           String
  topic             Topic        @relation(fields: [topicId], references: [id])
  type              QuestionType
  difficulty        Difficulty
  promptEn          String       @db.Text
  // Starts null on every AI-generated draft regardless of what the model
  // proposed — a human reviewer must explicitly supply it (see
  // QuestionPublishService.reviewDraft()) before approve() will accept
  // the draft. Never auto-trusted AI output.
  promptAr          String?      @db.Text
  optionsJson       Json? // choices for MULTIPLE_CHOICE/TRUE_FALSE
  correctAnswerJson Json
  explanationEn     String?      @db.Text
  explanationAr     String?      @db.Text
  status            String       @default("pending_review") // "pending_review" | "approved" | "rejected" | "published"
  isAiGenerated     Boolean      @default(false)
  aiProvider        String?
  aiModel           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  reviewedAt        DateTime?
  reviewedByUserId  String?
  rejectionReason   String?

  // Idempotent publish linkage — same pattern as LessonDraft.publishedTopicId:
  // unique so at most one draft can ever claim to have published a given
  // Question, and re-publishing an already-published draft is a safe no-op.
  publishedQuestionId String?   @unique
  publishedQuestion   Question? @relation(fields: [publishedQuestionId], references: [id])
  publishedAt         DateTime?

  @@index([status])
  @@index([topicId])
}

model QuestionAttempt {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  questionId  String
  question    Question       @relation(fields: [questionId], references: [id])
  answerJson  Json
  isCorrect   Boolean
  source      String         @default("practice") // "diagnostic" | "practice" | "quiz" — which flow produced this attempt
  attemptedAt DateTime       @default(now())

  @@index([studentId, questionId])
}

model Assessment {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  type      String // "diagnostic" | "topic" | "mock_exam"
  subjectId String?
  subject   Subject?       @relation(fields: [subjectId], references: [id])
  scoreJson Json // per-subject / per-topic breakdown
  createdAt DateTime       @default(now())

  @@index([studentId])
}

model QuizResult {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  quizType       String // "quiz" | "topic_assessment" | "mock_exam" | "lesson_check"
  // Launch-speed addition (2026-09-19): set for "lesson_check" (the short
  // post-lesson understanding check) so a Topic's own check results can be
  // queried directly — never set for the other quiz types, which can span
  // many topics at once and already record per-question topic names inside
  // resultJson.breakdown instead.
  topicId        String?
  topic          Topic?         @relation(fields: [topicId], references: [id])
  score          Float
  totalQuestions Int
  correctCount   Int
  resultJson     Json // detailed breakdown, weak topics, recommendations
  createdAt      DateTime       @default(now())

  @@index([studentId])
  @@index([topicId])
}

// ============ SUBSCRIPTIONS & AI CREDITS ============
//
// NOTE (Phase 8 correction): the earlier `SubscriptionPlan` model
// (generic FREE/BASIC/PLUS/PREMIUM USD tiers) was a Phase 1 draft that
// was never seeded after Phase 3 replaced it with real EGP pricing via
// `PricingPlan`. Nothing in the codebase referenced `SubscriptionPlan`
// at runtime, so it's removed here rather than carried forward — actual
// billing is tied to `PricingPlan` (Curriculum × Level, approved EGP
// numbers), which is what a real subscription should reference.

model Subscription {
  id                      String         @id @default(cuid())
  studentId               String         @unique // one active subscription per student for MVP simplicity
  student                 StudentProfile @relation(fields: [studentId], references: [id])
  // Subject-based pricing (2026-09-20): nullable now — a NEW subscription
  // is no longer tied to a curriculum-bundle PricingPlan at all; this stays
  // set (and readable) only on historical rows created under the old
  // model, preserved as-is for those existing payment records.
  pricingPlanId           String?
  pricingPlan             PricingPlan?   @relation(fields: [pricingPlanId], references: [id])
  additionalSubjectsCount Int            @default(0) // legacy (old bundle model) — always 0 on a subject-priced subscription, kept only so historical rows keep their original value
  // Subject-based pricing (2026-09-20): the exact Subject ids this
  // subscription's price/entitlement covers, snapshotted at checkout time
  // — a plain JSON string array rather than a new junction table, mirroring
  // this schema's existing "small flexible list" convention (e.g.
  // optionsJson on Question). Read once, at activation, to grant matching
  // StudentSubject rows — see BillingService. Null on historical
  // plan-based rows (nothing to backfill: those subjects were already
  // granted through the old flow).
  selectedSubjectIds      Json?
  monthlyTotalEGP         Decimal // sum of the selected Subjects' own priceEGP (subject-based pricing) — or, on a historical row, pricingPlan.monthlyPriceEGP + (additionalSubjectsCount * pricingPlan.additionalSubjectPriceEGP) as originally snapshotted
  status                  String // "pending" | "active" | "canceled" | "past_due"
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  paymentProvider         String? // "stripe" | "paymob" | "paypal"
  externalSubscriptionId  String? // the CHECKOUT SESSION id (e.g. Stripe "cs_...") — set at checkout-creation time, before the provider has assigned a real subscription; used to correlate "checkout.session.completed" and for payment-status verification.
  externalProviderSubscriptionId String? // the provider's own SUBSCRIPTION id (e.g. Stripe "sub_...") — a DIFFERENT identifier than the checkout session, only known once the provider assigns one. Captured from a verified webhook at activation time; used to correlate subscription-level lifecycle events ("customer.subscription.deleted", "invoice.payment_failed") that never carry a checkout session id. Nullable/historical: subscriptions created before this field existed simply never have it set.
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([externalProviderSubscriptionId])
}

model TutorQuestionPackPurchase {
  id                    String   @id @default(cuid())
  studentId             String
  student               StudentProfile @relation(fields: [studentId], references: [id])
  subjectId             String
  subject               Subject @relation(fields: [subjectId], references: [id])
  quantity              Int      @default(10)
  amountEGP             Decimal
  status                String   // "pending" | "paid" | "failed" | "canceled"
  paymentProvider       String?
  externalSessionId     String?
  externalEventId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  credits               TutorExtraQuestionCredit[]

  @@index([studentId, status])
  @@index([externalSessionId])
  @@unique([paymentProvider, externalEventId])
}

model TutorExtraQuestionCredit {
  id          String   @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id])
  usageDate   DateTime
  remaining   Int      @default(0)
  purchaseId  String
  purchase    TutorQuestionPackPurchase @relation(fields: [purchaseId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, subjectId, usageDate])
  @@index([studentId, subjectId, usageDate])
}

// Manual payment method: the student transfers money via InstaPay outside
// the app and submits a receipt; nothing here is provider-verified. Only
// an admin confirm (admin-instapay module) grants entitlement, by calling
// the SAME activation paths Stripe's webhook uses (BillingService.
// applyWebhookEvent / TutorQuestionPacksService.applyPaidPurchase) with
// providerKey "instapay" — this table never activates anything by itself.
enum InstapayPurchaseKind {
  SUBSCRIPTION
  QUESTION_PACK
}

enum InstapaySubmissionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model InstapayPaymentSubmission {
  id                 String                   @id @default(cuid())
  studentId          String
  student            StudentProfile           @relation(fields: [studentId], references: [id])
  kind               InstapayPurchaseKind
  subscriptionId     String? // set when kind = SUBSCRIPTION (informational — activation is looked up by referenceId, not this FK)
  packPurchaseId     String? // set when kind = QUESTION_PACK
  referenceId        String                   @unique // shown to the student at "initiate" time; the trusted lookup key for linking a submission back to its pending Subscription/Purchase row
  expectedAmountEGP  Decimal
  submittedAmountEGP Decimal
  senderName         String?
  note               String?
  receiptImage       Bytes // stored in Postgres, never on disk — no filename/path/static-hosting surface to secure
  receiptMimeType    String
  status             InstapaySubmissionStatus @default(PENDING_VERIFICATION)
  createdAt          DateTime                 @default(now())
  verifiedAt         DateTime?
  verifiedByUserId   String?
  rejectedAt         DateTime?
  rejectedByUserId   String?
  rejectionReason    String?

  @@index([status])
  @@index([studentId])
}

model TutorAnswerCache {
  id             String   @id @default(cuid())
  curriculumId   String
  gradeId        String
  subjectId      String
  topicId        String?
  language       String
  normalizedPrompt String @db.Text
  answer         String @db.Text
  provider       String
  model          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  curriculum     Curriculum @relation(fields: [curriculumId], references: [id])
  grade          Grade @relation(fields: [gradeId], references: [id])
  subject        Subject @relation(fields: [subjectId], references: [id])
  topic          Topic? @relation(fields: [topicId], references: [id])

  @@unique([curriculumId, gradeId, subjectId, topicId, language, normalizedPrompt])
  @@index([subjectId, language])
}

model AICredits {
  id          String         @id @default(cuid())
  studentId   String         @unique
  student     StudentProfile @relation(fields: [studentId], references: [id])
  balance     Int // remaining credits this period
  periodStart DateTime
  periodEnd   DateTime
  updatedAt   DateTime       @updatedAt
}

model AIUsage {
  id           String   @id @default(cuid())
  userId       String
  studentId    String? // StudentProfile.id, when the request came from a student context (nullable so AIUsage can log non-student AI calls later, e.g. admin content generation)
  subjectId    String? // which subject this usage counted against, for daily per-subject limits
  feature      String // "tutor_chat" | "assessment" | "exercise_gen" | "grading"
  provider     String // "openai" | "anthropic" | "local"
  model        String
  inputTokens  Int
  outputTokens Int
  creditsUsed  Int
  costUsd      Decimal
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([studentId, subjectId, createdAt])
  @@index([feature])
}

// Phase 10 concurrency hardening: the daily per-subject question limit
// used to be enforced by counting AIUsage rows at request time — a
// classic read-then-write race (two concurrent requests can both read
// "1 remaining" and both proceed). This table is the atomic reservation
// counter: AIUsageService.reserveDailySlot() does a single
// INSERT ... ON CONFLICT ... WHERE count < limit statement against this
// table, which Postgres executes atomically — two concurrent requests
// racing for the last slot cannot both succeed. AIUsage (above) remains
// the append-only cost/analytics ledger, written only after the AI
// provider call actually succeeds; this table is the enforcement gate,
// written before the provider is ever called.
model AIDailyUsageCounter {
  id        String   @id @default(cuid())
  studentId String
  subjectId String
  usageDate DateTime // truncated to the day (00:00) — one row per student+subject+day
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, usageDate])
}

// Phase 9.4C: the USD-denominated sibling of AIDailyUsageCounter above —
// same atomic "INSERT ... ON CONFLICT ... WHERE ... RETURNING" reservation
// pattern, applied to money instead of a question count, because
// AIUsageService.assertWithinBudget's SELECT-SUM-then-compare check is a
// classic TOCTOU race: two concurrent requests can both read the same
// pre-request spend total and both pass, together exceeding the budget
// (see AIUsageService.assertWithinBudget's Phase 9.4B test coverage,
// which proves the race exists). One table serves BOTH the global cap and
// every per-user cap via the (scope, scopeKey) discriminator — "global"
// rows use scopeKey="global"; per-user rows use scopeKey=userId — rather
// than two near-identical tables. `committedUsd` is the current best
// estimate of total USD exposure for that scope+day, whether still
// in-flight (an unreconciled reservation's estimate) or already actual
// (a reconciled reservation's real cost) — AIBudgetReservation below is
// the per-request record of which reservation contributed what, needed
// for idempotent release/reconcile; this table alone cannot answer "did
// request X already reconcile" and is never queried directly by request
// code, only atomically incremented/decremented by AIUsageService.
model AIDailyBudgetCounter {
  id          String   @id @default(cuid())
  scope       String // "global" | "user"
  scopeKey    String // "global" for the single global row; StudentProfile-independent userId for a per-user row
  usageDate   DateTime // truncated to the day (00:00) — one row per scope+scopeKey+day
  committedUsd Decimal @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([scope, scopeKey, usageDate])
}

enum AIBudgetReservationStatus {
  RESERVED
  RECONCILED
  RELEASED
}

// Phase 9.4C: one row per individual reserveBudget() call — the durable,
// cross-process idempotency record Objective 4 requires. Its `id` is the
// reservation token callers hold onto; reconcileBudget()/releaseBudget()
// both do an atomic "UPDATE ... WHERE id = ? AND status = 'RESERVED'"
// status transition before touching AIDailyBudgetCounter, so a second
// call with the same id (a retry, a duplicate release-then-reconcile,
// etc.) matches zero rows and is a safe no-op — the accumulator is never
// adjusted twice for the same reservation. estimatedUsd is fixed at
// reserve time (what was actually deducted from both accumulator rows);
// reconciledUsd is filled in only on a successful RECONCILED transition.
model AIBudgetReservation {
  id            String                     @id @default(cuid())
  userId        String
  usageDate     DateTime // truncated to the day (00:00) — must match the AIDailyBudgetCounter rows this reservation touched
  estimatedUsd  Decimal
  reconciledUsd Decimal?
  status        AIBudgetReservationStatus  @default(RESERVED)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// Phase 10 concurrency/idempotency hardening: payment providers
// (Stripe now, Fawry later) deliver webhooks at-least-once — the same
// event can arrive more than once. Without this table, a duplicate
// "subscription activated" delivery would silently re-run
// BillingService.applyWebhookEvent(), resetting currentPeriodStart and
// potentially corrupting billing period data. Each (provider,
// externalEventId) pair is logged exactly once via a unique constraint;
// a duplicate delivery hits that constraint and is treated as a no-op,
// enforced by the database itself rather than an application-level
// check that could itself race.
model WebhookEventLog {
  id              String   @id @default(cuid())
  provider        String // "stripe" | "fawry" | "paymob" | "paypal" | "instapay"
  externalEventId String // the provider's own event ID (e.g. Stripe's "evt_...")
  eventType       String
  receivedAt      DateTime @default(now())

  @@unique([provider, externalEventId])
}

// ============ AI TUTOR CONVERSATIONS ============

model AIConversation {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  subjectId String?
  topicId   String?
  title     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages AIMessage[]
  lessonSession LessonSession?

  @@index([studentId])
}

// ============ INTERACTIVE LESSON ENGINE (pilot) ============
//
// The resumable "where is this child right now inside this lesson"
// record. One Topic (mapped 1:1 to a real curriculum lesson, e.g. book
// lesson "3-1") can have many LessonSessions across different students,
// but a given student has exactly one session per Topic — re-entering the
// lesson resumes it rather than starting a second one. Every AI-generated
// teaching turn and every student interruption Q&A for this run is stored
// as a normal AIMessage on the linked AIConversation, so the existing
// Tutor speech endpoint (/tutor/speech, which verifies text against a
// real assistant message in a conversation the caller owns) can be reused
// unchanged for lesson TTS — no parallel speech/security infrastructure.
model LessonSession {
  id               String         @id @default(cuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id])
  topicId          String
  topic            Topic          @relation(fields: [topicId], references: [id])
  conversationId   String         @unique
  conversation     AIConversation @relation(fields: [conversationId], references: [id])
  status           String         @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED"
  currentStepIndex Int            @default(0)
  stepResultsJson  Json? // [{ stepId, delivered, attempts, correct, hintGiven }] — fine-grained record for THIS run
  nonProgressTurns Int            @default(0) // Phase 9.4B spend guard — interruptions/non-answer CHECK messages, never deterministic answer attempts. See NON_PROGRESS_TURN_LIMIT.
  startedAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  completedAt      DateTime?

  @@unique([studentId, topicId])
  @@index([studentId])
  @@index([topicId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id])
  role           String // "user" | "assistant" | "system"
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ============ GAMIFICATION ============

model Achievement {
  id            String  @id @default(cuid())
  code          String  @unique
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  icon          String?

  studentAchievements StudentAchievement[]
}

model StudentAchievement {
  id            String         @id @default(cuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  achievementId String
  achievement   Achievement    @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime       @default(now())

  @@unique([studentId, achievementId])
}

// ============ AUDIT / ADMIN ============

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model AIProviderConfig {
  id                 String   @id @default(cuid())
  providerKey        String   @unique // "openai" | "anthropic" | "local"
  model              String
  isActive           Boolean  @default(false)
  costPerInputToken  Decimal
  costPerOutputToken Decimal
  updatedAt          DateTime @updatedAt
}

// ============ PRICING (EGP) ============
//
// Pricing is per Curriculum × Level (not per individual Grade row — a
// "Level" here is a pricing tier, e.g. "Primary" or "Grade 6-8", that can
// span multiple Grade rows). British and American curricula are kept as
// SEPARATE Curriculum rows even though they currently share numbers —
// business rule, not a schema shortcut, so they can diverge freely later.

model PricingPlan {
  id                       String     @id @default(cuid())
  curriculumId             String
  curriculum               Curriculum @relation(fields: [curriculumId], references: [id])
  levelCodeEn              String // e.g. "Primary", "Preparatory", "Secondary Year 1-2", "Grade 6-8"
  levelCodeAr              String
  monthlyPriceEGP          Decimal
  includedSubjects         Int        @default(3)
  additionalSubjectPriceEGP Decimal
  isActive                 Boolean    @default(true)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  subscriptions Subscription[]

  @@unique([curriculumId, levelCodeEn])
  @@index([curriculumId])
}

// Extra AI questions beyond the included daily allowance. Prices are TBD
// on purpose — configurable from the Admin Panel, never hardcoded.
model QuestionPackage {
  id            String   @id @default(cuid())
  nameEn        String
  nameAr        String
  questionCount Int
  priceEGP      Decimal? // null = price not yet set (TBD), package inactive until priced
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Generic key-value store for tunable business rules that don't deserve
// their own table (e.g. "default_daily_ai_questions_per_subject": 10).
// Read/cached by the backend, editable from the Admin Panel.
model SystemConfig {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

// Mirrors AIProviderConfig's pattern: which payment provider is active is
// a database row, not a code path, so switching Stripe/Paymob/PayPal is
// an admin/config change. Secrets (API keys, webhook signing secrets)
// stay in environment variables — this table only holds non-secret
// routing/config data, per the "never expose payment secrets" rule.
model PaymentProviderConfig {
  id           String   @id @default(cuid())
  providerKey  String   @unique // "stripe" | "paymob" | "paypal"
  isActive     Boolean  @default(false)
  publicConfig Json? // non-secret config (e.g. Stripe publishable key), safe to read from the admin panel
  updatedAt    DateTime @updatedAt
}

// ============ FREE TRIAL V1 (2026-09-20) ============
//
// A student picks exactly TWO Subjects (once — never replaceable, see
// TrialService.selectSubjects) and gets one free Interactive Lesson in
// EACH. Deliberately separate from StudentSubject (paid/onboarding
// entitlement) and from the older FreeTutorTrial (a single-subject,
// two-QUESTION free-form Tutor-chat trial, unrelated and unchanged) —
// this only ever unlocks ONE specific Topic's worth of Interactive
// Lesson + its associated Practice/Quiz per selected Subject, never
// free-form Tutor chat.

model LessonTrial {
  id         String         @id @default(cuid())
  studentId  String         @unique
  student    StudentProfile @relation(fields: [studentId], references: [id])
  // Exactly two Subject ids, validated once at creation (TrialService.
  // selectSubjects) and never mutated afterward — a plain Json array,
  // mirroring this schema's existing convention for small fixed lists
  // (e.g. Subscription.selectedSubjectIds) rather than a new join table.
  subjectIds Json
  createdAt  DateTime       @default(now())

  consumptions LessonTrialConsumption[]
}

// One row = one Subject's free lesson has been used, on exactly one
// Topic. The @@unique([trialId, subjectId]) constraint IS the
// concurrency control: two simultaneous reservation attempts for the
// same Subject race on this Postgres constraint, and only one INSERT can
// ever win — no read-then-write window to exploit. Since a LessonTrial
// only ever holds two subjectIds, at most two of these rows can ever
// exist per trial, which is also what caps the account-wide total at
// two, with no separate counter to keep in sync.
model LessonTrialConsumption {
  id        String      @id @default(cuid())
  trialId   String
  trial     LessonTrial @relation(fields: [trialId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id])
  topicId   String
  topic     Topic       @relation(fields: [topicId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([trialId, subjectId])
  @@index([studentId])
}

// ============ REFERRAL V1 (2026-09-20) ============

model ReferralCode {
  id        String         @id @default(cuid())
  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id])
  code      String         @unique
  createdAt DateTime       @default(now())
}

// One row per REFERRED student (@@unique below), created once at/around
// their signup and never mutated except by the two state transitions
// below — this is what makes "referral cannot be changed later" and "one
// referred account rewards only once" simple DB-level guarantees rather
// than application-level promises:
//   1. earnedAt: set exactly once, the first time the referred student's
//      Subscription activates (BillingService's two activation paths,
//      inside the SAME transaction as activation — see
//      ReferralService.earnReward). A conditional updateMany guarded by
//      `earnedAt: null` makes this race-safe under concurrent/duplicate
//      webhook delivery, on top of the outer WebhookEventLog idempotency
//      guard those paths already have.
//   2. appliedAt/appliedSubjectId/appliedExpiresAt: set once the
//      REFERRER chooses which Subject receives the reward (ReferralService.
//      applyReward) — a separate conditional updateMany guarded by
//      `appliedAt: null`, equally race-safe against a double-click.
// No fake Subscription/payment row is ever created for the reward — the
// reward IS this row plus a real (time-limited) StudentSubject grant.
model Referral {
  id                String         @id @default(cuid())
  referrerStudentId String
  referrer          StudentProfile @relation("ReferralsMade", fields: [referrerStudentId], references: [id])
  referredStudentId String         @unique
  referredStudent   StudentProfile @relation("ReferredStudent", fields: [referredStudentId], references: [id])
  code              String // the code actually redeemed, snapshotted for audit even if the referrer later regenerated/changed anything
  createdAt         DateTime       @default(now())

  earnedAt          DateTime? // set once, at the referred student's first successful paid activation
  appliedAt         DateTime? // set once, when the referrer applies the earned reward to a Subject
  appliedSubjectId  String?
  appliedSubject    Subject?  @relation(fields: [appliedSubjectId], references: [id])
  appliedExpiresAt  DateTime? // the resulting StudentSubject.expiresAt after applying — kept here too, purely for audit display

  @@index([referrerStudentId])
}
